# Copy to .env.local and fill in the values from .local/zitadel/dms.env
# (written by scripts/zitadel-setup.sh). .env.local is not committed.

# ZITADEL issuer (OIDC authority).
VITE_OIDC_ISSUER=http://localhost:8085
# DMS_ZITADEL_CLIENT_ID
VITE_OIDC_CLIENT_ID=
# DMS_ZITADEL_PROJECT_ID; adds the project to the access token audience.
VITE_OIDC_PROJECT_ID=
# Base URL of the DMS API. `/api` goes through the Vite dev proxy.
VITE_API_BASE_URL=/api

# Backend the dev proxy forwards /api to (dev server only, not exposed to the browser).
DMS_BACKEND_URL=http://localhost:8080
